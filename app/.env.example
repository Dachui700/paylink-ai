# ============================================================
# PayPal Sandbox API Credentials
# ============================================================
# Obtain these from: https://developer.paypal.com/dashboard/applications/sandbox
# Log in with your PayPal Developer account, create an App, and copy the Client ID and Secret.
# If these are left blank or unset, the app runs in MOCK MODE automatically.

PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# PayPal API Base (Defaults to sandbox: https://api-m.sandbox.paypal.com)
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Server Port
PORT=3000
